std_msgs/Header header
uint32 step_index

uint8 type_of_output
uint8 TRAJECTORY      = 0
uint8 DISCRETE_ACTION = 1

# When mode == trajectory → use this field
nav_msgs/Path trajectory

# When mode == discrete_action → use this field
int32[] action_codes
uint8 STOP         = 0
uint8 MOVE_FORWARD = 1
uint8 TURN_LEFT    = 2
uint8 TURN_RIGHT   = 3
